{
  "name": "arbitragex-dapp",
  "version": "1.0.0",
  "description": "Decentralized Arbitrage Exchange Platform",
  "main": "index.js",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy": "hardhat run scripts/deploy.js --network polygon",
    "deploy:testnet": "hardhat run scripts/deploy.js --network mumbai",
    "start": "react-scripts start",
    "build": "react-scripts build",
    "build:production": "GENERATE_SOURCEMAP=false react-scripts build",
    "node": "hardhat node",
    "console": "hardhat console",
    "deploy:cloudflare": "wrangler publish",
    "deploy:cloudflare:staging": "wrangler publish --env staging",
    "deploy:cloudflare:production": "wrangler publish --env production",
    "preview": "wrangler dev",
    "lint": "eslint src/**/*.{js,jsx}",
    "lint:fix": "eslint src/**/*.{js,jsx} --fix",
    "format": "prettier --write src/**/*.{js,jsx,css,md}",
    "analyze": "npm run build && npx serve -s build",
    "test:contracts": "hardhat test",
    "test:frontend": "react-scripts test --watchAll=false",
    "coverage": "react-scripts test --coverage --watchAll=false"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^4.9.0",
    "@uniswap/v2-core": "^1.0.1",
    "@uniswap/v2-periphery": "^1.1.0-beta.0",
    "ethers": "^6.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "web3": "^1.9.0",
    "axios": "^1.4.0",
    "socket.io-client": "^4.7.2",
    "chart.js": "^4.3.0",
    "react-chartjs-2": "^5.2.0",
    "bootstrap": "^5.3.0",
    "react-bootstrap": "^2.8.0",
    "react-router-dom": "^6.14.0",
    "react-toastify": "^9.1.3"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@nomicfoundation/hardhat-ethers": "^3.1.0",
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.0",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.8",
    "@nomicfoundation/hardhat-verify": "^2.0.0",
    "@typechain/ethers-v6": "^0.4.3",
    "@typechain/hardhat": "^9.1.0",
    "chai": "^4.3.7",
    "hardhat": "^2.19.0",
    "hardhat-deploy": "^0.12.0",
    "hardhat-deploy-ethers": "^0.3.0-beta.13",
    "eslint": "^8.45.0",
    "eslint-config-react-app": "^7.0.1",
    "prettier": "^3.0.0",
    "wrangler": "^3.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ohllmuzz/Minerx.git"
  },
  "keywords": [
    "arbitrage",
    "dex",
    "cryptocurrency",
    "trading",
    "polygon",
    "matic",
    "defi",
    "blockchain",
    "ethereum"
  ],
  "author": "ArbitrageX Team",
  "license": "MIT",
  "homepage": "https://arbitragex.app"
}
